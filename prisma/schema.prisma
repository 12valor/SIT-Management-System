// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  EMPLOYER
  COORDINATOR
}

enum PostingStatus {
  OPEN
  CLOSED
}

enum PlacementType {
  ON_SITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LogbookStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

// --- Auth.js Models (NextAuth) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core Application Models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // For Credentials login
  role          UserRole  @default(STUDENT)
  isApproved    Boolean   @default(false)
  course        String? // For Students
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Connections
  accounts Account[]
  sessions Session[]

  // SIT Specific Relations
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  applications    Application[]
  logbookEntries  LogbookEntry[]
  createdPostings SITPosting[]     @relation("EmployerPostings")
  evaluations     SITEvaluation[]  @relation("StudentEvaluations")
  placements      SITPlacement[]   @relation("StudentPlacements")
  documents       SITDocument[]
  certificates    SITCertificate[] @relation("StudentCertificates")
  notifications   Notification[]
}

model Company {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  industry      String
  description   String?  @db.Text
  location      String?
  logoUrl       String?
  bannerUrl     String?
  websiteUrl    String?
  facebookUrl   String?
  linkedinUrl   String?
  twitterUrl    String?
  instagramUrl  String?
  slots         Int      @default(0)
  isVerified    Boolean  @default(false)
  showInMarquee Boolean  @default(false)
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  employers  User[]
  postings   SITPosting[]
  placements SITPlacement[]
}

model SITPosting {
  id               String        @id @default(cuid())
  title            String
  description      String        @db.Text
  requiredHours    Int           @default(300)
  status           PostingStatus @default(OPEN)
  location         String
  type             PlacementType @default(ON_SITE)
  tags             String[]      @default([])
  requirements     String[]      @default([])
  responsibilities String[]      @default([])
  posterUrl        String?       @db.Text
  postedAt         DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  employer     User           @relation("EmployerPostings", fields: [employerId], references: [id])
  employerId   String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  applications Application[]
  placements   SITPlacement[]
}

model Application {
  id        String            @id @default(cuid())
  status    ApplicationStatus @default(PENDING)
  notes     String?           @db.Text
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  posting   SITPosting    @relation(fields: [postingId], references: [id], onDelete: Cascade)
  postingId String
  student   User          @relation(fields: [studentId], references: [id])
  studentId String
  placement SITPlacement?

  @@unique([postingId, studentId])
}

model SITPlacement {
  id        String          @id @default(cuid())
  status    PlacementStatus @default(ACTIVE)
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String      @unique
  student       User        @relation("StudentPlacements", fields: [studentId], references: [id])
  studentId     String
  posting       SITPosting  @relation(fields: [postingId], references: [id])
  postingId     String
  company       Company     @relation(fields: [companyId], references: [id])
  companyId     String

  logbookEntries LogbookEntry[]
  evaluations    SITEvaluation[]
  certificates   SITCertificate[]

  @@index([studentId, status])
  @@index([companyId, status])
}

model LogbookEntry {
  id        String        @id @default(cuid())
  date      DateTime
  hours     Float
  tasks     String        @db.Text
  status    LogbookStatus @default(PENDING)
  feedback  String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  student     User          @relation(fields: [studentId], references: [id])
  studentId   String
  placement   SITPlacement? @relation(fields: [placementId], references: [id])
  placementId String?
}

model SITEvaluation {
  id               String   @id @default(cuid())
  supervisorName   String
  companyName      String
  technicalSkills  Int
  professionalism  Int
  punctuality      Int
  qualityOfWork    Int
  overallGrade     Float
  comments         String   @db.Text
  recommendForHire Boolean  @default(true)
  submittedAt      DateTime @default(now())

  // Relations
  student     User          @relation("StudentEvaluations", fields: [studentId], references: [id])
  studentId   String
  placement   SITPlacement? @relation(fields: [placementId], references: [id])
  placementId String?
}

model SITDocument {
  id           String         @id @default(cuid())
  name         String
  type         String
  url          String? // If using external storage like Vercel Blob
  status       DocumentStatus @default(PENDING)
  feedback     String?        @db.Text
  reviewedAt   DateTime?
  reviewedById String?
  uploadedAt   DateTime       @default(now())

  // Relations
  student   User   @relation(fields: [studentId], references: [id])
  studentId String
}

model SITCertificate {
  id            String            @id @default(cuid())
  certificateId String            @unique
  studentName   String
  course        String
  companyName   String
  totalHours    Float
  grade         Float
  status        CertificateStatus @default(ISSUED)
  issuedAt      DateTime          @default(now())

  student     User          @relation("StudentCertificates", fields: [studentId], references: [id])
  studentId   String
  placement   SITPlacement? @relation(fields: [placementId], references: [id])
  placementId String?

  @@index([studentId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String // e.g., 'LOGBOOK', 'APPLICATION', 'SYSTEM'
  link      String? // Deep-link to the relevant module
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., 'hero_slides'
  value     String   @db.Text // JSON string or simple text
  updatedAt DateTime @updatedAt
}
